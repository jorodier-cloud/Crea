---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  fullHeight?: boolean;
}

const { title, description = 'Constructeur de site hybride : IA generative et editeur visuel.', fullHeight = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ctext y='26' font-size='26'%3E%E2%9C%A6%3C/text%3E%3C/svg%3E" />
  </head>
  <body class={fullHeight ? 'h-dvh overflow-hidden' : ''}>
    <slot />
  </body>
</html>
